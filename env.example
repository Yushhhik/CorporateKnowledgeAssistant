TELEGRAM_TOKEN=telegram_bot_token
PROXY_URL=socks5://host.docker.internal:10808

OPERATOR_CHAT_ID=operator_chat_id
API_URL=http://app:8000/webhook

OLLAMA_BASE_URL=http://sprashivaem_u_natashi:11434
OLLAMA_MODEL=sprashivaem_u_natashi
# модель для картинок (описание скриншотов в документах и фото от пользователей)
OLLAMA_VISION_MODEL=llava

HF_HUB_OFFLINE=1


POSTGRES_USER=admin
POSTGRES_PASSWORD=secret_db_pass
POSTGRES_DB=corp_bot
DATABASE_URL=postgresql+asyncpg://admin:secret_db_pass@db:5432/corp_bot

# Адрес сервиса files (порт 8001), по нему открываются ссылки на документы в ответах бота.
# Пусто: ссылки ведут на http://localhost:8001 и кликабельны на компьютере, где запущен Docker.
# Чтобы открывались с других устройств: IP компьютера в сети (http://192.168.1.10:8001) или внешний адрес/туннель.
PUBLIC_FILES_URL=https://docs.example.com  (или адрес туннеля cloudflared/ngrok на порт 8001)
PUBLIC_FILES_URL=
# Секрет подписи ссылок (любая длинная случайная строка). Если сменить, старые ссылки перестанут открываться.
FILES_SECRET=


# --- Бот: администраторы и поддержка ---
# Telegram ID администраторов через запятую (дополнительно к админам из БД: столбец is_admin / role='admin')
ADMIN_IDS=
# Часы работы поддержки для сообщения при вызове оператора, формат «пн-пт 09:00-18:00». Пусто: не показывать
SUPPORT_HOURS=
# Таймаут ответа API, секунды (долгие ответы модели)
CORE_TIMEOUT=1300
# Часовой пояс для аналитики (смещение от UTC, часы)
STATS_UTC_OFFSET=3
